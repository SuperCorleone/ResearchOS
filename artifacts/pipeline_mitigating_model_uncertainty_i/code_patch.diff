+import argparse
+import hashlib
+import json
+import logging
+import os
+import platform
+import random
+import sys
+import time
+from pathlib import Path
+
+try:
+    import numpy as np
+except ImportError:  # pragma: no cover
+    np = None
+
+
+PIPELINE_ID = "mitigating_model_uncertainty_i"
+RAW_DATA_DIR = Path(f"/data/raw/{PIPELINE_ID}")
+MANIFEST_PATH = Path("data_manifest.yaml")
+REQUIRED_METRICS = ["accuracy_rq1", "accuracy_rq2"]
+REFERENCE_PAPER = "Taming Model Uncertainty in Self-adaptive Systems Using Bayesian Model Averaging"
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Fast-fail experiment harness for stacking vs BMA on the TUNE robotics case study."
+    )
+    parser.add_argument("--seed", type=int, default=42, help="Global random seed.")
+    parser.add_argument(
+        "--data-dir",
+        type=str,
+        default=str(RAW_DATA_DIR),
+        help="Directory expected to contain the exact reference dataset artifacts.",
+    )
+    return parser.parse_args()
+
+
+def seed_everything(seed: int) -> None:
+    random.seed(seed)
+    os.environ["PYTHONHASHSEED"] = str(seed)
+    if np is not None:
+        np.random.seed(seed)
+
+
+def dependency_versions() -> dict:
+    return {
+        "python": platform.python_version(),
+        "numpy": getattr(np, "__version__", "NOT_INSTALLED"),
+        "platform": platform.platform(),
+    }
+
+
+def read_manifest_hash(manifest_path: Path) -> str:
+    if not manifest_path.exists():
+        return None
+    for line in manifest_path.read_text(encoding="utf-8").splitlines():
+        if line.strip().startswith("directory_hash:"):
+            return line.split(":", 1)[1].strip().strip('"').strip("'")
+    return None
+
+
+def hash_directory(path: Path) -> str:
+    hasher = hashlib.sha256()
+    for file_path in sorted([p for p in path.rglob("*") if p.is_file()]):
+        hasher.update(str(file_path.relative_to(path)).encode("utf-8"))
+        hasher.update(file_path.read_bytes())
+    return hasher.hexdigest()
+
+
+def locate_reference_data(data_dir: Path) -> dict:
+    info = {
+        "exists": data_dir.exists(),
+        "rows": 0,
+        "data_hash": read_manifest_hash(MANIFEST_PATH),
+        "files": [],
+    }
+    if not data_dir.exists():
+        return info
+    files = sorted([p for p in data_dir.rglob("*") if p.is_file()])
+    info["files"] = [str(p) for p in files]
+    if info["data_hash"] is None:
+        info["data_hash"] = hash_directory(data_dir)
+    return info
+
+
+def build_not_implemented_metrics(data_present: bool) -> dict:
+    missing_suffix = (
+        "reference dataset directory is missing at /data/raw/mitigating_model_uncertainty_i"
+        if not data_present
+        else "exact reference split/preprocessing and planner interface are unrecovered in current fast-fail artifacts"
+    )
+    metrics = {
+        "accuracy_rq1": (
+            "NOT_IMPLEMENTED: requires exact reference robotics dataset, recovered train/test split, "
+            f"and paper-faithful preprocessing from {REFERENCE_PAPER}; {missing_suffix}"
+        ),
+        "accuracy_rq2": (
+            "NOT_IMPLEMENTED: requires exact Analyze-to-Plan interface, reference planner/metaheuristic, "
+            f"and recovered paper split from {REFERENCE_PAPER}; {missing_suffix}"
+        ),
+    }
+    for metric_name in REQUIRED_METRICS:
+        if metric_name not in metrics:
+            raise RuntimeError(f"Required metric missing from output: {metric_name}")
+    return metrics
+
+
+def emit_provenance(data_dir: Path, data_info: dict) -> None:
+    print(f"[provenance] data_source=file")
+    print(f"[provenance] reference_paper={REFERENCE_PAPER}")
+    print(f"[provenance] expected_data_dir={data_dir}")
+    print(f"[provenance] data_exists={data_info['exists']}")
+    print(f"[provenance] data_rows={data_info['rows']}")
+    print(f"[provenance] split_sizes=NOT_AVAILABLE_UNTIL_REFERENCE_SPLIT_RECOVERED")
+
+
+def write_results(result: dict) -> None:
+    Path("results.json").write_text(json.dumps(result, indent=2), encoding="utf-8")
+
+
+def main() -> int:
+    args = parse_args()
+    logging.basicConfig(level=logging.INFO, format="%(levelname)s:%(message)s")
+    start_time = time.perf_counter()
+    print(json.dumps({"dependency_versions": dependency_versions()}))
+    seed_everything(args.seed)
+
+    data_dir = Path(args.data_dir)
+    data_info = locate_reference_data(data_dir)
+    emit_provenance(data_dir, data_info)
+
+    if not data_info["exists"]:
+        logging.error(
+            "Reference dataset missing. Per data consistency rules, no synthetic or substitute data may be used. "
+            "Populate /data/raw/%s with the exact TUNE artifacts before rerunning.",
+            PIPELINE_ID,
+        )
+
+    metrics = build_not_implemented_metrics(data_info["exists"])
+    runtime_seconds = time.perf_counter() - start_time
+    result = {
+        "metrics": metrics,
+        "config": {
+            "data_source": "file",
+            "data_split_seed": 42,
+            "data_rows": data_info["rows"],
+            "data_hash": data_info["data_hash"],
+            "reference_paper": REFERENCE_PAPER,
+            "expected_data_dir": str(data_dir),
+            "fast_fail_reason": "Reference-faithful execution is blocked until the exact dataset, split, preprocessing, and planner interface are recovered.",
+        },
+        "seed": args.seed,
+        "runtime_seconds": runtime_seconds,
+    }
+    write_results(result)
+    print(json.dumps(result))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
+
